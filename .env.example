# Public OIDC configuration for the React SPA (no secrets).
# The Compose frontend bakes VITE_* values in at image build time.
# For the optional Vite-Dev-Server, copy .env.local.example to .env.local.
#
# External Keycloak: set issuer and client ID for that realm, e.g.
#   VITE_OIDC_ISSUER=https://login.docfaust.de/realms/<realm>
#   VITE_OIDC_CLIENT_ID=<public-spa-client>
#
# Frontend and backend use only standard OIDC/OAuth2/JWT settings.
# There is no local-Keycloak-specific application logic.

# Keycloak issuer / OIDC authority (local or external)
VITE_OIDC_ISSUER=

# Public SPA client ID configured in Keycloak (no client secret)
VITE_OIDC_CLIENT_ID=

# Spring Boot API base URL.
# Vite-Dev (`npm run dev`): http://localhost:8080 (direct backend port).
# Containerized frontend: empty string so the browser calls relative /api/...
# and nginx proxies to the backend Compose service.
VITE_API_BASE_URL=http://localhost:8080

# Backend CORS (Compose/Spring). Must match the SPA origin, not a wildcard.
# FRONTEND_ORIGIN=http://localhost:5173
