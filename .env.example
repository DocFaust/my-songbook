# Public OIDC configuration for the React SPA (no secrets).
# Copy to .env.local and adjust for your Keycloak realm/client.

# Keycloak issuer URL, e.g. https://login.docfaust.de/realms/<realm>
VITE_OIDC_ISSUER=

# Public SPA client ID configured in Keycloak
VITE_OIDC_CLIENT_ID=

# Spring Boot API base URL (default for local dev)
VITE_API_BASE_URL=http://localhost:8080

# Backend CORS (Compose/Spring). Must match the SPA origin, not a wildcard.
# FRONTEND_ORIGIN=http://localhost:5173
