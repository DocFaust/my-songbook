{
  "name": "my-songbook",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/verify-pwa-build.js",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:report": "eslint -f checkstyle -o eslint-report.xml .",
    "lint:sonar": "mkdir -p reports/eslint && eslint src -f json -o reports/eslint/eslint-sonar.json",
    "test": "vitest",
    "test:ci": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "owasp": "bash ../scripts/owasp-check.sh",
    "verify:local-stack": "node ../scripts/verify-local-stack.js"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.4.0",
    "chordsheetjs": "^18.0.0",
    "idb": "^8.0.3",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.3.0",
    "react-oidc-context": "^3.3.1",
    "react-router-dom": "^7.18.4",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-formatter-checkstyle": "^9.0.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jest-environment-jsdom": "^30.5.2",
    "jsdom": "^30.1.1",
    "owasp-dependency-check": "^1.0.1",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  }
}
