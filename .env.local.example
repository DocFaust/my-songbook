# Optional Vite-only workflow (`npm run dev`) against the Compose stack.
# The containerized frontend does not read this file; its VITE_* values
# are baked in at image build time (see compose.yaml).
#
# These values are for the imported development realm only.
# They are not production credentials and must not be reused outside
# the local Compose environment.

VITE_OIDC_ISSUER=http://localhost:8081/realms/my-songbook
VITE_OIDC_CLIENT_ID=my-songbook-spa
VITE_API_BASE_URL=http://localhost:8080
